{
	"name": "@shelchin/task-manager",
	"version": "0.1.0",
	"description": "Tree-based task management with split storage, Merkle tree support, pause/resume, and Svelte 5 reactivity",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./storage": {
			"types": "./dist/storage/index.d.ts",
			"default": "./dist/storage/index.js"
		},
		"./stores": {
			"types": "./dist/stores/index.d.ts",
			"svelte": "./dist/stores/index.js",
			"default": "./dist/stores/index.js"
		},
		"./merkle": {
			"types": "./dist/merkle.d.ts",
			"default": "./dist/merkle.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.3.7",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/svelte": "^5.2.0",
		"@vitest/browser": "^3.0.0",
		"@vitest/coverage-v8": "^3",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^26.0.0",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"task-manager",
		"task-queue",
		"merkle-tree",
		"progress-tracking",
		"pause-resume",
		"indexeddb",
		"persistence"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/atshelchin/biubiu.tools.git",
		"directory": "packages/task-manager"
	}
}
