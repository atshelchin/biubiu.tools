{
	"name": "@shelchin/drag-sortable",
	"version": "0.0.1",
	"description": "Svelte action for drag-and-drop sorting with ghost element and real-time reordering",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"test": "vitest run"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.3.0",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"svelte",
		"drag",
		"drop",
		"sortable",
		"dnd",
		"reorder"
	],
	"license": "MIT"
}
