{
	"name": "@shelchin/drag-sortable",
	"version": "0.0.1",
	"description": "Svelte action for drag-and-drop sorting with ghost element and real-time reordering",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
