{
	"name": "@shelchin/data-table",
	"version": "0.0.1",
	"description": "Svelte 5 data table component with sorting, pagination, and custom cell rendering",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"test": "vitest run"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.552.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.3.0",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"svelte",
		"data-table",
		"table",
		"sortable",
		"pagination"
	],
	"license": "MIT"
}
