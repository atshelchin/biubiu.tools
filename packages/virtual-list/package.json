{
	"name": "@shelchin/virtual-list",
	"version": "0.0.1",
	"description": "Svelte 5 virtual list component for efficient rendering of large lists",
	"type": "module",
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"dist",
		"src",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"test": "vitest run"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.3.0",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"svelte",
		"virtual",
		"list",
		"virtualization",
		"scroll",
		"performance"
	],
	"license": "MIT"
}
