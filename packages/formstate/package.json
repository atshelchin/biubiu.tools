{
	"name": "@shelchin/formstate",
	"version": "0.0.1",
	"description": "Interface-first form state management with headless components for Svelte 5",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./zod": {
			"types": "./dist/adapters/zod.d.ts",
			"default": "./dist/adapters/zod.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "svelte-package -i src",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"zod": "^4.3.5"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"dependencies": {
		"immer": "^10.2.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.3.7",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0",
		"vitest": "^3.2.3"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"form",
		"formstate",
		"validation",
		"headless"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/atshelchin/biubiu.tools.git",
		"directory": "packages/formstate"
	}
}
