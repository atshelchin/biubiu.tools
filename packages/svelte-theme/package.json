{
	"name": "@shelchin/svelte-theme",
	"version": "0.0.1",
	"description": "Svelte 5 theme store with dark/light mode and SSR support",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
